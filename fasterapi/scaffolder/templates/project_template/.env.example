# Database: mongodb, postgres or supabase
DB_TYPE=mongodb
# MongoDB settings (DB_TYPE=mongodb)
MONGO_URL=mongodb://localhost:27017
DB_NAME=app
# Postgres settings (DB_TYPE=postgres or supabase), e.g. postgresql://user:pass@host:5432/dbname
# Supabase on serverless: use the transaction pooler URL (port 6543)
DATABASE_URL=
DB_POOL_MAX_SIZE=5

ENV=development
# Set to false on serverless hosts; defaults to false automatically on Vercel
ENABLE_SCHEDULER=true
SECRET_KEY=
SESSION_SECRET_KEY=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_SENDER_NAME=FasterAPI
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=1.0
EMAIL_QUEUE_ENABLED=true

SECRETID=
# Hosted Redis (e.g. Upstash): set REDIS_URL, e.g. rediss://default:password@host:6379
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
DEFAULT_ADMIN_EMAIL=
LOCATION_API=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET_HASH=
CELERY_RESULT_BACKEND=
CELERY_BROKER_URL=
CORS_ORIGINS=http://localhost:3000
ROLE_RATE_LIMITS=anonymous:20/minute,user:80/minute,admin:140/minute
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=uploads
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT_URL=
PAYMENT_DEFAULT_PROVIDER=flutterwave
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Built-in super admin with full admin permissions; set both to enable it (password: 12+ characters)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CELERY_CUSTOM_WORKER_POOL=celery_aio_pool.pool:AsyncIOPool
